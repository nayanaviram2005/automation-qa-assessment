{
  "name": "Uptime Monitor - Conduit API",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "every5",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { t0: Date.now() } }];"
      },
      "id": "stamp",
      "name": "Stamp Start",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        100
      ]
    },
    {
      "parameters": {
        "url": "http://localhost:3000/api/tags",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "ping",
      "name": "Ping App",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        100
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "const t0 = $('Stamp Start').first().json.t0;\nconst ms = Date.now() - t0;\nconst j = $input.first().json;\nconst status = typeof j.statusCode === 'number' ? j.statusCode : 0;\nconst detail = (j.error && (j.error.message || j.error)) || 'no response';\nconst reason = status ? 'HTTP ' + status : 'No response: ' + String(detail).slice(0, 200);\nconst ok = status === 200;\nconst s = $getWorkflowStaticData('global');\ns.checks = s.checks || [];\ns.checks.push({ t: Date.now(), status, ms, ok });\ns.checks = s.checks.slice(-600);\ns.failStreak = ok ? 0 : (s.failStreak || 0) + 1;\nconst when = new Date().toISOString();\nreturn [{\n  json: {\n    ok,\n    status,\n    ms,\n    reason,\n    failStreak: s.failStreak,\n    checkedAt: when,\n    message: ok ? '' : 'APP DOWN: ' + reason + ' after ' + ms + ' ms (failed check ' + s.failStreak + ' in a row)\\nURL: http://localhost:3000/api/tags\\nTime: ' + when\n  }\n}];"
      },
      "id": "eval",
      "name": "Evaluate Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ok-true",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "healthy",
      "name": "Status Is 200?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        100
      ]
    },
    {
      "parameters": {},
      "id": "noop",
      "name": "Healthy - No Alert",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1100,
        20
      ]
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "={{ $json.message }}",
        "options": {}
      },
      "id": "send-down-alert",
      "name": "Send Down Alert",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1100,
        200
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "discordWebhookApi": {
          "id": "REPLACE_ME",
          "name": "Discord Webhook account"
        }
      }
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "daily",
      "name": "Daily 9am Summary",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $getWorkflowStaticData('global');\nconst since = Date.now() - 24 * 3600 * 1000;\nconst c = (s.checks || []).filter(x => x.t >= since);\nif (c.length === 0) {\n  return [{ json: { message: 'Daily uptime summary: no checks recorded in the last 24 hours.' } }];\n}\nconst fails = c.filter(x => !x.ok).length;\nconst times = c.map(x => x.ms);\nconst avg = Math.round(times.reduce((a, b) => a + b, 0) / times.length);\nconst max = Math.max(...times);\nconst up = ((c.length - fails) / c.length * 100).toFixed(2);\nreturn [{\n  json: {\n    message: 'Daily uptime summary (last 24h)\\nChecks: ' + c.length + '\\nFailed: ' + fails + '\\nUptime: ' + up + '%\\nAverage response: ' + avg + ' ms\\nSlowest response: ' + max + ' ms'\n  }\n}];"
      },
      "id": "summary",
      "name": "Build Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        380
      ]
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "={{ $json.message }}",
        "options": {}
      },
      "id": "send-daily-summary",
      "name": "Send Daily Summary",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        440,
        380
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "discordWebhookApi": {
          "id": "REPLACE_ME",
          "name": "Discord Webhook account"
        }
      }
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [
        [
          {
            "node": "Stamp Start",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Stamp Start": {
      "main": [
        [
          {
            "node": "Ping App",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ping App": {
      "main": [
        [
          {
            "node": "Evaluate Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluate Check": {
      "main": [
        [
          {
            "node": "Status Is 200?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Status Is 200?": {
      "main": [
        [
          {
            "node": "Healthy - No Alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Down Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily 9am Summary": {
      "main": [
        [
          {
            "node": "Build Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Summary": {
      "main": [
        [
          {
            "node": "Send Daily Summary",
