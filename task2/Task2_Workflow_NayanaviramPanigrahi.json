{
  "name": "Morning Brief - GitHub n8n Digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Every Hour (test)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "url": "https://api.github.com/search/repositories",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "topic:n8n"
            },
            {
              "name": "sort",
              "value": "stars"
            },
            {
              "name": "order",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "20"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-morning-brief"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "search",
      "name": "GitHub Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        200
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\nconst repos = Array.isArray(res.items) ? res.items : [];\nif (repos.length === 0) {\n  throw new Error('GitHub search returned no repositories');\n}\nreturn repos\n  .filter(r => !r.archived)\n  .sort((a, b) => b.stargazers_count - a.stargazers_count)\n  .slice(0, 5)\n  .map(r => ({\n    json: {\n      name: r.full_name,\n      stars: r.stargazers_count,\n      url: r.html_url,\n      description: r.description || '',\n      language: r.language || 'n/a'\n    }\n  }));"
      },
      "id": "top5",
      "name": "Top 5 Repos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        120
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.name }}/readme",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.raw+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-morning-brief"
            }
          ]
        },
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "readme"
            }
          }
        }
      },
      "id": "readme",
      "name": "Fetch README",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        120
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const repos = $('Top 5 Repos').all();\nconst enriched = $input.all();\nlet readmeFailures = 0;\nconst lines = repos.map((r, i) => {\n  const e = (enriched[i] && enriched[i].json) || {};\n  const raw = typeof e.readme === 'string' ? e.readme : '';\n  if (!raw) readmeFailures += 1;\n  const snippet = raw\n    ? raw.replace(/!\\[[^\\]]*\\]\\([^)]*\\)/g, ' ').replace(/<[^>]*>?/g, ' ').replace(/\\[([^\\]]*)\\]\\([^)]*\\)/g, '$1').replace(/[#>*`\\[\\]]/g, '').replace(/\\s+/g, ' ').trim().slice(0, 120) || 'README has no plain text'\n    : 'README unavailable';\n  return (i + 1) + '. ' + r.json.name + ' (' + r.json.stars + ' stars, ' + r.json.language + ')\\n' + r.json.url + '\\n> ' + snippet;\n});\nconst topStars = repos[0].json.stars;\nconst body = lines.join('\\n\\n');\nconst note = readmeFailures ? '\\n\\n(' + readmeFailures + ' README lookup(s) failed)' : '';\nreturn [{\n  json: {\n    topStars,\n    readmeFailures,\n    hotMessage: ('HOT morning brief - top n8n repo has ' + topStars + ' stars\\n\\n' + body + note).slice(0, 1900),\n    quietMessage: ('Quiet morning brief - nothing above 1000 stars today\\n\\n' + body + note).slice(0, 1900)\n  }\n}];"
      },
      "id": "digest",
      "name": "Build Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "stars-gt-1000",
              "leftValue": "={{ $json.topStars }}",
              "rightValue": 1000,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if",
      "name": "Top Repo Over 1000 Stars?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        120
      ]
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "={{ $json.hotMessage }}",
        "options": {}
      },
      "id": "send-hot-digest",
      "name": "Send Hot Digest",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1320,
        40
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "discordWebhookApi": {
          "id": "REPLACE_ME",
          "name": "Discord Webhook (morning brief)"
        }
      }
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "={{ $json.quietMessage }}",
        "options": {}
      },
      "id": "send-quiet-digest",
      "name": "Send Quiet Digest",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1320,
        220
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "discordWebhookApi": {
          "id": "REPLACE_ME",
          "name": "Discord Webhook (morning brief)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst msg = (j.error && (j.error.message || j.error)) || j.message || JSON.stringify(j);\nreturn [{\n  json: {\n    content: 'Morning brief FAILED at ' + new Date().toISOString() + '\\nReason: ' + String(msg).slice(0, 500) + '\\nNo digest was sent; check the n8n execution log.'\n  }\n}];"
      },
      "id": "fmterr",
      "name": "Format Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        380
      ]
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "={{ $json.content }}",
        "options": {}
      },
      "id": "send-failure-alert",
      "name": "Send Failure Alert",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        880,
        380
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "discordWebhookApi": {
          "id": "REPLACE_ME",
          "name": "Discord Webhook (morning brief)"
        }
      }
    }
  ],
  "connections": {
    "Every Hour (test)": {
      "main": [
        [
          {
            "node": "GitHub Search",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub Search": {
      "main": [
        [
          {
            "node": "Top 5 Repos",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Format Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Top 5 Repos": {
      "main": [
        [
          {
            "node": "Fetch README",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Format Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch README": {
      "main": [
        [
          {
            "node": "Build Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Digest": {
      "main": [
        [
          {
            "node": "Top Repo Over 1000 Stars?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Top Repo Over 1000 Stars?": {
      "main": [
        [
          {
            "node": "Send Hot Digest",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Quiet Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Error": {
      "main": [
        [
          {
            "node": "Send Failure Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}